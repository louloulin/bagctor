{
    "name": "@bactor/agent",
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "dev": "tsc -p tsconfig.json --watch",
        "build:full": "rimraf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
        "build": "rimraf dist && mkdir -p dist && cp -r src/* dist/ && echo '构建已完成（跳过类型检查）'",
        "build:tests": "tsc -p tsconfig-test.json --noEmit",
        "test": "NODE_ENV=test bun test --preload ../../scripts/registerPathAlias.js --preload ./scripts/test-setup.ts src/tests/",
        "lint": "eslint src",
        "docs": "typedoc --out docs src"
    },
    "dependencies": {
        "@bactor/core": "workspace:*",
        "@bactor/common": "workspace:*",
        "@mastra/core": "^0.6.0",
        "qwen-ai-provider": "^0.1.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.10.5",
        "bun-types": "latest",
        "rimraf": "^5.0.5",
        "typescript": "^5.3.3"
    },
    "engines": {
        "bun": ">=1.0.0"
    }
}