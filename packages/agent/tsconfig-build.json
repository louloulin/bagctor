{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "typeRoots": [
            "./src/types",
            "./node_modules/@types",
            "../../node_modules/@types",
            "../../node_modules/bun-types"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "test/**/*",
        "src/tests/**/*"
    ]
}