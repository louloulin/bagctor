{
  "name": "@bactor/http",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "test": "bun test",
    "example:basic": "bun run src/examples/basic_server.ts",
    "example:middleware": "bun run src/examples/middleware_server.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "benchmark": "bun run src/performance/run_benchmark.ts",
    "benchmark:full": "bun run src/performance/run_benchmark.ts full",
    "benchmark:load": "bun run src/performance/run_benchmark.ts load",
    "benchmark:data": "bun run src/performance/run_benchmark.ts data",
    "benchmark:quick": "bun run src/performance/quick_benchmark.ts"
  },
  "dependencies": {
    "@bactor/core": "workspace:*",
    "@bactor/common": "workspace:*"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.6",
    "@types/node": "^20.10.5",
    "autocannon": "8.0.0",
    "bun-types": "latest",
    "typescript": "^5.3.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}