{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": [
      "bun-types"
    ],
    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "src/middleware/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "test/**/*",
    "src/tests/**/*"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../common"
    }
  ]
}